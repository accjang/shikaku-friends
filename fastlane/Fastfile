# App Store Connect에 스토어 문구·스크린샷을 올린다(빌드는 올리지 않고, 심사 제출도 하지 않는다).
# 준비: fastlane/.env.example을 fastlane/.env로 복사해 API 키 세 값을 채운다(docs/store/asc-setup.md 9장).
# 실행(저장소 폴더에서):
#   fastlane ios store_text   문구만(이름·부제·설명·키워드·지원/처리방침 주소) — 26개 언어
#   fastlane ios store_all    문구 + 스크린샷(언어마다 5장, 기존 스크린샷은 바꿔 넣는다)
default_platform(:ios)

APP_ID = 'app.shikakufriends.mobile'

platform :ios do
  private_lane :upload do |options|
    # 문구·스크린샷 폴더를 listing·art에서 새로 만든다
    sh('python3', '../tools/build_fastlane_metadata.py')
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: File.expand_path(ENV.fetch('ASC_KEY_PATH'))
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

    # 새 언어의 '앱 정보'(이름·부제) 칸을 먼저 만든다. deliver는 이미 있는 언어만 비교해서, 칸이 없으면 "바뀐 것 없음"으로 건너뛴다.
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App Store Connect에서 앱 #{APP_ID}를 찾지 못했어요") unless app
    app_info = app.fetch_edit_app_info
    UI.user_error!('고칠 수 있는 앱 정보가 없어요(심사 중이면 끝난 뒤 다시)') unless app_info
    base = File.directory?('metadata') ? '.' : 'fastlane' # 실행 위치가 fastlane 폴더든 저장소 폴더든 찾게
    meta = File.join(base, 'metadata')
    wanted = Dir.children(meta).select { |d| File.directory?(File.join(meta, d)) }
    missing = wanted - app_info.get_app_info_localizations.map(&:locale)
    missing.each do |locale|
      UI.message("앱 정보 언어 추가: #{locale}")
      app_info.create_app_info_localization(attributes: { locale: locale })
    end

    # 심사 정보(메모 + 연락처). 첫 버전에는 심사 정보가 아직 없어 deliver가 "No data"로 멈추므로 여기서 만들게 한다.
    # App Store Connect는 연락처 네 칸(이름·성·전화·이메일)이 모두 있어야 만들어 준다 — fastlane/.env에 적는다(git에 안 올라감).
    review = { notes: File.read(File.join(base, 'review_notes.txt')).strip }
    contact = { first_name: 'ASC_REVIEW_FIRST_NAME', last_name: 'ASC_REVIEW_LAST_NAME',
                phone_number: 'ASC_REVIEW_PHONE', email_address: 'ASC_REVIEW_EMAIL' }
    empty = contact.values.select { |env| ENV[env].to_s.strip.empty? }
    UI.user_error!("fastlane/.env에 심사 연락처를 채워 주세요: #{empty.join(', ')} (전화는 +821012345678 형식)") unless empty.empty?
    contact.each { |key, env| review[key] = ENV[env].strip }

    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      app_review_information: review,
      metadata_path: './fastlane/metadata',
      screenshots_path: './fastlane/screenshots',
      skip_binary_upload: true,
      skip_screenshots: !options[:screenshots],
      overwrite_screenshots: options[:screenshots],
      submit_for_review: false,
      run_precheck_before_submit: false,
      # 올리기 전 미리보기 웹페이지 확인 단계를 건너뛴다
      force: true
    )
  end

  desc '스토어 문구만 올린다'
  lane :store_text do
    upload(screenshots: false)
  end

  desc '스토어 문구와 스크린샷을 올린다'
  lane :store_all do
    upload(screenshots: true)
  end
end
