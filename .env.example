# 출시 빌드용 키. 이 파일을 .env로 복사해 채운다(.env는 git에 올리지 않는다). 자세한 순서: docs/RELEASE.md
# 비어 있으면: 개발 빌드는 구글 테스트 광고, 릴리스 빌드는 광고가 꺼진다.

# AdMob 광고 단위 ID (AdMob 콘솔 → 앱 → 광고 단위)
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=

# 설정 화면 링크(비면 줄을 숨긴다)
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
