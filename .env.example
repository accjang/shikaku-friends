# 출시 빌드용 키. 이 파일을 .env로 복사해 채운다(.env는 git에 올리지 않는다). 자세한 순서: docs/RELEASE.md
# 개발 빌드는 언제나 구글 테스트 광고. 릴리스 빌드는 실제 광고(config.ts의 ID). 결제 키가 비어 있으면 개발 빌드는 가상 결제, 릴리스 빌드는 결제가 꺼진다.

# AdMob 광고 단위 ID — 비워 두면 src/core/config.ts의 실제 ID를 쓴다(바꿀 때만 적는다)
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=

# RevenueCat 공개 SDK 키 (RevenueCat → Project → API keys, appl_… / goog_…)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# 공유 문구 끝에 붙는 스토어 주소(출시 뒤)
EXPO_PUBLIC_STORE_URL=

# 설정 화면 링크(비우면 src/core/config.ts 기본값: 처리방침 accjang.github.io/shikaku-privacy/, 문의 gpawod2@gmail.com)
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
